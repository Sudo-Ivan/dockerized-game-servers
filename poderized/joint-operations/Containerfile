ARG BASE_IMAGE=ghcr.io/sudo-ivan/poderized-game-servers/steam-base:latest
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="joint-operations" \
      org.opencontainers.image.description="Joint Operations: Typhoon Rising host (Wine, BYO game files)" \
      org.opencontainers.image.licenses="ISC"

RUN if ! grep -q '^\[xlibre\]' /etc/pacman.conf; then \
      curl -fsSL "https://xlibre-arch.github.io/xlibre-archlinux.asc" \
        -o /tmp/xlibre-archlinux.asc \
      && pacman-key --add /tmp/xlibre-archlinux.asc \
      && pacman-key --lsign-key B97F7C613F359424 \
      && rm -f /tmp/xlibre-archlinux.asc \
      && printf '\n[xlibre]\nServer = https://packages.xlibre.net/arch/stable/$arch\n' >> /etc/pacman.conf; \
    fi \
  && pacman -Sy --noconfirm --needed \
    wine \
    xlibre-xserver-xvfb \
    libxi \
  && pacman -Scc --noconfirm \
  && rm -rf /var/cache/pacman/pkg/* /tmp/* /var/tmp/* \
  && useradd -m -u 1000 jointops \
  && mkdir -p /opt/jointops /tmp/.X11-unix \
  && chmod 1777 /tmp/.X11-unix \
  && chown -R jointops:jointops /opt/jointops /home/jointops

ENV JO_DIR="/opt/jointops" \
    WINEPREFIX="/opt/jointops/.wine" \
    WINEARCH="win64" \
    WINEDEBUG="-all"

COPY --chmod=755 container-entrypoint.sh /container-entrypoint.sh
COPY --chown=jointops:jointops --chmod=755 entrypoint.sh /home/jointops/entrypoint.sh
COPY --chmod=755 healthcheck.sh /healthcheck.sh

WORKDIR ${JO_DIR}

EXPOSE 7597/udp 32768/udp 49152/udp 64206/udp

STOPSIGNAL SIGTERM

ENTRYPOINT ["/container-entrypoint.sh"]
