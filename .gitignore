# Runtime volumes (keep dirs via .gitkeep)
**/data/*
!**/data/.gitkeep

poderized/arma/arma-3/server/*
!poderized/arma/arma-3/server/.gitkeep
poderized/arma/arma-3/configs/*
!poderized/arma/arma-3/configs/.gitkeep
poderized/arma/arma-3/profiles/*
!poderized/arma/arma-3/profiles/.gitkeep
poderized/arma/arma-3/cache/*
!poderized/arma/arma-3/cache/.gitkeep

.env
*.env
!.env.example
!poderized/minecraft/defaults.env
*.log
.DS_Store

# Python
__pycache__/
*.py[cod]

# Host tool backups
backups/

# Docs (Zensical)
site/
docs/game-icons/
.venv/
