# Runtime volumes (keep dirs via .gitkeep)
**/data/*
!**/data/.gitkeep

dockerized/arma/arma-3/server/*
!dockerized/arma/arma-3/server/.gitkeep
dockerized/arma/arma-3/configs/*
!dockerized/arma/arma-3/configs/.gitkeep
dockerized/arma/arma-3/profiles/*
!dockerized/arma/arma-3/profiles/.gitkeep
dockerized/arma/arma-3/cache/*
!dockerized/arma/arma-3/cache/.gitkeep

.env
*.env
!.env.example
!dockerized/minecraft/defaults.env
*.log
.DS_Store

# Python
__pycache__/
*.py[cod]

# Host tool backups
backups/

# Docs (Starlight / Astro)
docs/node_modules/
docs/dist/
docs/.astro/
docs/package-lock.json
