---
const label = Astro.locals.t('search.label')
const cancelLabel = Astro.locals.t('search.cancelLabel')
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`
const indexUrl = `${base}search-index.json`
---

<site-search class={Astro.props.class} data-index-url={indexUrl}>
	<button type="button" data-open-modal disabled hidden aria-label={label} aria-keyshortcuts="Control+K">
		<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
			<path
				d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7Z"
			></path>
		</svg>
		<span class="trigger-label" aria-hidden="true">Search docs...</span>
		<span class="trigger-keys sl-hidden md:sl-flex" data-shortcut hidden>
			<kbd>/</kbd>
			<kbd data-mod-chord><span data-mod>Ctrl</span>K</kbd>
		</span>
	</button>

	<dialog aria-label={label}>
		<div class="dialog-frame">
			<div class="search-bar">
				<svg aria-hidden="true" class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path
						d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7Z"
					></path>
				</svg>
				<label class="search-field">
					<span class="sr-only">{label}</span>
					<input type="search" data-search-input placeholder="Search documentation..." autocomplete="off" />
				</label>
				<button type="button" data-close-modal aria-label={cancelLabel}>
					<kbd>ESC</kbd>
				</button>
			</div>

			<div class="results-pane">
				<ul data-results class="results" role="listbox" aria-label={label}></ul>
				<p data-hint class="hint">Type to search documentation</p>
				<p data-empty class="empty" hidden></p>
			</div>

			<div class="search-footer">
				<span>Search by Fuse.js</span>
				<div class="hints">
					<span><kbd>/</kbd> search</span>
					<span><kbd>↑↓</kbd> navigate</span>
					<span><kbd>↵</kbd> select</span>
					<span><kbd>Esc</kbd> close</span>
				</div>
			</div>
		</div>
	</dialog>
</site-search>

<script>
	import Fuse from 'fuse.js'

	class SiteSearch extends HTMLElement {
		/** @type {Fuse<{ title: string, description: string, body: string, href: string }> | null} */
		fuse = null
		/** @type {AbortController | null} */
		loadController = null
		selectedIndex = -1

		connectedCallback() {
			const openBtn = this.querySelector('[data-open-modal]')
			const closeBtn = this.querySelector('[data-close-modal]')
			const dialog = this.querySelector('dialog')
			const input = this.querySelector('[data-search-input]')
			const results = this.querySelector('[data-results]')
			const empty = this.querySelector('[data-empty]')
			const hint = this.querySelector('[data-hint]')
			const shortcut = this.querySelector('[data-shortcut]')
			const mod = this.querySelector('[data-mod]')
			const frame = this.querySelector('.dialog-frame')

			if (
				!(openBtn instanceof HTMLButtonElement) ||
				!(closeBtn instanceof HTMLButtonElement) ||
				!(dialog instanceof HTMLDialogElement) ||
				!(input instanceof HTMLInputElement) ||
				!(results instanceof HTMLElement) ||
				!(empty instanceof HTMLElement) ||
				!(hint instanceof HTMLElement) ||
				!(frame instanceof HTMLElement)
			) {
				return
			}

			openBtn.hidden = false
			openBtn.disabled = false

			if (shortcut instanceof HTMLElement && mod instanceof HTMLElement) {
				if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform) || navigator.userAgent.includes('Mac')) {
					mod.textContent = '⌘'
					openBtn.setAttribute('aria-keyshortcuts', 'Meta+K')
				}
				shortcut.hidden = false
			}

			const snippet = (item, matches) => {
				const bodyMatch = matches?.find((m) => m.key === 'body' || m.key === 'description')
				const source = item.description || item.body || ''
				if (!bodyMatch?.indices?.length) {
					return source.length > 110 ? `${source.slice(0, 110)}...` : source
				}
				const [start, end] = bodyMatch.indices[0]
				const from = Math.max(0, start - 40)
				const to = Math.min(source.length, end + 60)
				let text = source.slice(from, to)
				if (from > 0) text = `...${text}`
				if (to < source.length) text = `${text}...`
				return text
			}

			const setSelected = (index) => {
				const items = [...results.querySelectorAll('.result')]
				this.selectedIndex = index
				items.forEach((el, i) => {
					el.classList.toggle('is-active', i === index)
					if (i === index) el.scrollIntoView({ block: 'nearest' })
				})
			}

			const render = (query) => {
				results.replaceChildren()
				empty.hidden = true
				const q = query.trim()
				if (!q || !this.fuse) {
					hint.hidden = false
					return
				}
				hint.hidden = true
				const matches = this.fuse.search(q, { limit: 12 })
				if (!matches.length) {
					empty.hidden = false
					empty.textContent = `No results found for "${q}"`
					this.selectedIndex = -1
					return
				}
				for (const match of matches) {
					const item = match.item
					const li = document.createElement('li')
					const a = document.createElement('a')
					a.href = item.href
					a.className = 'result'
					a.setAttribute('role', 'option')

					const icon = document.createElement('span')
					icon.className = 'result-icon'
					icon.setAttribute('aria-hidden', 'true')
					icon.innerHTML =
						'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>'

					const text = document.createElement('span')
					text.className = 'result-text'
					const title = document.createElement('span')
					title.className = 'result-title'
					title.textContent = item.title
					const desc = document.createElement('span')
					desc.className = 'result-desc'
					desc.textContent = snippet(item, match.matches)
					text.append(title, desc)
					a.append(icon, text)
					li.append(a)
					results.append(li)
				}
				setSelected(0)
			}

			const ensureIndex = async () => {
				if (this.fuse) return
				this.loadController?.abort()
				this.loadController = new AbortController()
				const url = this.dataset.indexUrl
				if (!url) throw new Error('missing search index url')
				const res = await fetch(url, { signal: this.loadController.signal })
				if (!res.ok) throw new Error(`search index HTTP ${res.status}`)
				const data = await res.json()
				this.fuse = new Fuse(data.documents || [], {
					keys: [
						{ name: 'title', weight: 0.7 },
						{ name: 'description', weight: 0.2 },
						{ name: 'body', weight: 0.3 },
					],
					threshold: 0.3,
					ignoreLocation: true,
					includeMatches: true,
					includeScore: true,
					useTokenSearch: true,
					tokenMatch: 'all',
				})
			}

			const openModal = async (event) => {
				event?.stopPropagation()
				dialog.showModal()
				document.body.toggleAttribute('data-search-modal-open', true)
				input.focus()
				try {
					await ensureIndex()
					render(input.value)
				} catch (err) {
					hint.hidden = true
					empty.hidden = false
					empty.textContent = 'Search index unavailable.'
					console.error(err)
				}
			}

			const closeModal = () => dialog.close()

			openBtn.addEventListener('click', (event) => {
				void openModal(event)
			})
			closeBtn.addEventListener('click', closeModal)
			dialog.addEventListener('close', () => {
				document.body.toggleAttribute('data-search-modal-open', false)
			})
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) closeModal()
			})
			input.addEventListener('input', () => render(input.value))
			results.addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('a')) closeModal()
			})
			results.addEventListener('mousemove', (event) => {
				const target = event.target
				if (!(target instanceof Element)) return
				const link = target.closest('.result')
				if (!(link instanceof HTMLElement)) return
				const items = [...results.querySelectorAll('.result')]
				const index = items.indexOf(link)
				if (index >= 0) setSelected(index)
			})

			input.addEventListener('keydown', (event) => {
				const items = [...results.querySelectorAll('.result')]
				if (event.key === 'ArrowDown' && items.length) {
					event.preventDefault()
					setSelected((this.selectedIndex + 1) % items.length)
				} else if (event.key === 'ArrowUp' && items.length) {
					event.preventDefault()
					setSelected((this.selectedIndex - 1 + items.length) % items.length)
				} else if (event.key === 'Enter' && this.selectedIndex >= 0 && items[this.selectedIndex]) {
					event.preventDefault()
					items[this.selectedIndex].click()
				} else if (event.key === 'Escape') {
					closeModal()
				}
			})

			window.addEventListener('keydown', (event) => {
				const target = event.target
				const typing =
					target instanceof HTMLElement &&
					(target.tagName === 'INPUT' ||
						target.tagName === 'TEXTAREA' ||
						target.isContentEditable)
				if (event.key === '/' && !typing && !dialog.open) {
					event.preventDefault()
					void openModal()
					return
				}
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
					event.preventDefault()
					if (dialog.open) closeModal()
					else void openModal()
				}
			})
		}
	}

	customElements.define('site-search', SiteSearch)
</script>

<style>
	site-search {
		display: contents;
	}

	button[data-open-modal] {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid #262626;
		border-radius: 0.5rem;
		background: #111111;
		color: #a3a3a3;
		cursor: pointer;
		height: 2.25rem;
		padding-inline: 0.75rem 0.5rem;
		font: inherit;
		font-size: 0.875rem;
		min-width: 0;
		width: min(18rem, 42vw);
		text-align: left;
	}

	button[data-open-modal]:hover {
		border-color: #404040;
		color: #e5e5e5;
	}

	.trigger-label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.trigger-keys {
		align-items: center;
		gap: 0.25rem;
	}

	button[data-open-modal] kbd,
	.search-bar kbd,
	.search-footer kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.25rem;
		padding: 0.1rem 0.35rem;
		border: 1px solid #333333;
		border-radius: 0.25rem;
		background: #1a1a1a;
		color: #a3a3a3;
		font-family: inherit;
		font-size: 0.7rem;
		line-height: 1.2;
	}

	dialog {
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #e5e5e5;
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
	}

	dialog[open] {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 6rem 1rem 2rem;
	}

	dialog::backdrop {
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(4px);
	}

	.dialog-frame {
		position: relative;
		width: min(32rem, 100%);
		max-height: min(60vh, 32rem);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 0.75rem;
		background: #111111;
		border: 1px solid #262626;
		box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.65);
	}

	.search-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid #262626;
	}

	.search-icon {
		flex-shrink: 0;
		color: #737373;
	}

	.search-field {
		flex: 1;
		min-width: 0;
	}

	.search-field input {
		width: 100%;
		border: 0;
		outline: none;
		background: transparent;
		color: #f5f5f5;
		font: inherit;
		font-size: 0.95rem;
		padding: 0;
	}

	.search-field input::placeholder {
		color: #737373;
	}

	button[data-close-modal] {
		border: 0;
		background: transparent;
		color: #737373;
		cursor: pointer;
		padding: 0;
	}

	button[data-close-modal]:hover {
		color: #e5e5e5;
	}

	.results-pane {
		flex: 1;
		overflow: auto;
		padding: 0.5rem;
		min-height: 10rem;
	}

	.results {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.25rem;
	}

	.result {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.result:hover,
	.result.is-active {
		background: #1a1a1a;
	}

	.result-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		background: #171717;
		color: #737373;
		flex-shrink: 0;
	}

	.result-text {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.result-title {
		font-size: 0.875rem;
		font-weight: 600;
		color: #f5f5f5;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.result-desc {
		font-size: 0.75rem;
		color: #737373;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hint,
	.empty {
		margin: 0;
		padding: 3rem 1rem;
		text-align: center;
		color: #737373;
		font-size: 0.875rem;
	}

	.search-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding: 0.55rem 1rem;
		border-top: 1px solid #262626;
		background: #0f0f0f;
		color: #737373;
		font-size: 0.7rem;
	}

	.hints {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.hints span {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	@media (max-width: 49.99rem) {
		button[data-open-modal] {
			width: 2.25rem;
			padding-inline: 0;
			justify-content: center;
		}

		.trigger-label,
		.trigger-keys {
			display: none;
		}

		dialog[open] {
			padding: 0;
		}

		.dialog-frame {
			width: 100%;
			max-height: 100%;
			height: 100%;
			border-radius: 0;
		}
	}
</style>

<style is:global>
	[data-search-modal-open] {
		overflow: hidden;
	}
</style>
