---
import { gameIcons, gameIconFit } from '../generated/game-icons.mjs'

const title = Astro.locals.starlightRoute.entry.data.title
const slug = Astro.locals.starlightRoute.entry.id
const serverSlug = slug.match(/^servers\/([^/]+)$/)?.[1]
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`
const iconFile = serverSlug ? gameIcons[serverSlug] : undefined
const iconSrc = iconFile ? `${base}game-icons/${iconFile}` : undefined
const iconFit = serverSlug ? gameIconFit[serverSlug] ?? 'cover' : 'cover'
---

<div
	class:list={['page-title', { 'has-game-icon': Boolean(iconSrc) }]}
	style={iconSrc ? `--icon-bg: url(${JSON.stringify(iconSrc)});` : undefined}
>
	{iconSrc && <span class="page-title-backdrop" aria-hidden="true" />}
	{
		iconSrc && (
			<span class:list={['game-title-icon-wrap', { 'fit-contain': iconFit === 'contain' }]}>
				<img
					class="game-title-icon"
					src={iconSrc}
					alt=""
					width="64"
					height="64"
					decoding="async"
				/>
			</span>
		)
	}
	<span class="page-title-text">
		<h1 id="_top">{title}</h1>
	</span>
</div>

<style>
	.page-title {
		position: relative;
		display: flex;
		align-items: center;
		margin-top: 0.5rem;
	}

	.page-title.has-game-icon {
		border-radius: 0.85rem;
		border: 1px solid var(--sl-color-hairline);
		overflow: hidden;
		isolation: isolate;
		background: #0c0c0c;
		height: 5.5rem;
	}

	.page-title-backdrop {
		position: absolute;
		inset: -35%;
		z-index: -2;
		background-image: var(--icon-bg);
		background-size: cover;
		background-position: center 30%;
		filter: blur(30px) saturate(1.7) brightness(0.62);
		transform: scale(1.15);
	}

	.page-title.has-game-icon::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(120deg, rgb(10 10 10 / 0.55) 0%, rgb(10 10 10 / 0.88) 70%),
			radial-gradient(140% 160% at 0% 0%, rgb(255 255 255 / 0.06), transparent 55%);
	}

	.game-title-icon-wrap {
		position: relative;
		display: block;
		flex-shrink: 0;
		height: 100%;
		aspect-ratio: 2 / 3;
		overflow: hidden;
		background: #141414;
		border-right: 1px solid rgb(255 255 255 / 0.08);
		box-shadow: 1px 0 0 rgb(0 0 0 / 0.35);
	}

	.game-title-icon-wrap.fit-contain {
		padding: 0.5rem;
		background: #101010;
	}

	.game-title-icon-wrap.fit-contain::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: var(--icon-bg);
		background-size: cover;
		background-position: center;
		filter: blur(12px) saturate(1.5) brightness(0.42);
		transform: scale(1.2);
	}

	.game-title-icon-wrap.fit-contain .game-title-icon {
		position: relative;
		z-index: 1;
		object-fit: contain;
		object-position: center;
	}

	.game-title-icon {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.page-title-text {
		display: flex;
		align-items: center;
		min-width: 0;
		padding: 0.75rem 1.15rem;
	}

	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.page-title.has-game-icon h1 {
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
	}

	@media (min-width: 50rem) {
		.page-title.has-game-icon {
			height: 7rem;
		}

		.page-title-text {
			padding: 0.9rem 1.4rem;
		}
	}
</style>
