---
import Default from '@astrojs/starlight/components/Hero.astro'

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`

const entry = Astro.locals.starlightRoute.entry
const hero = entry.data.hero

if (hero?.actions?.length) {
	hero.actions = hero.actions.map((action) => {
		const link = action.link
		if (!link || /^([a-z]+:)?\/\//i.test(link) || link.startsWith('#') || link.startsWith('mailto:')) {
			return action
		}
		if (link.startsWith(base)) return action
		if (link.startsWith('/')) {
			return { ...action, link: `${base}${link.slice(1)}` }
		}
		return { ...action, link: `${base}${link}` }
	})
}
---

<Default><slot /></Default>
