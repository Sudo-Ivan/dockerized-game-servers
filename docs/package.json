{
  "name": "dockerized-game-servers-docs",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "node scripts/build-assets.mjs && astro dev",
    "start": "node scripts/build-assets.mjs && astro dev",
    "build": "node scripts/build-assets.mjs && astro build && node scripts/check-tokens.mjs",
    "icons": "node scripts/fetch-game-icons.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.0.2",
    "fflate": "^0.8.3",
    "fuse.js": "7.5.0"
  }
}
