{
  "name": "dockerized-game-servers-docs",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/check-tokens.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.0.2"
  }
}
