  "name": "Return to Castle Wolfenstein",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Return to Castle Wolfenstein using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/rtcw:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 27960/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/rtcw:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export RTCW_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
