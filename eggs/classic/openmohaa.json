{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-02T01:19:13+00:00",
  "name": "OpenMoHAA",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "OpenMoHAA using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/openmohaa:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 12203/udp, 12300/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/openmohaa:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export MOHAA_INSTALL_DIR=/home/container/install MOHAA_DATA_DIR=/home/container/data; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Steam Username",
      "description": "Steam account for dedicated server installs. Use anonymous unless the game requires a login.",
      "env_variable": "STEAM_USERNAME",
      "default_value": "anonymous",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:64",
      "field_type": "text"
    },
    {
      "name": "Steam Password",
      "description": "Steam password when not using anonymous login.",
      "env_variable": "STEAM_PASSWORD",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:64",
      "field_type": "text"
    },
    {
      "name": "Steam Guard Code",
      "description": "One-time Steam Guard code for SteamCMD login.",
      "env_variable": "STEAM_GUARD_CODE",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:32",
      "field_type": "text"
    },
    {
      "name": "Openmohaa Version",
      "description": "Container environment OPENMOHAA_VERSION.",
      "env_variable": "OPENMOHAA_VERSION",
      "default_value": "v0.82.1",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:512",
      "field_type": "text"
