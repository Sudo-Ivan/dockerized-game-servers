{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-02T20:24:09+00:00",
  "name": "Quake III Arena",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Quake III Arena using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/quake3:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 27960/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/quake3:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export Q3_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Q3 Port",
      "description": "Container environment Q3_PORT.",
      "env_variable": "Q3_PORT",
      "default_value": "27960",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|integer|between:0,65535",
      "field_type": "text"
    },
    {
      "name": "Q3 Startmap",
