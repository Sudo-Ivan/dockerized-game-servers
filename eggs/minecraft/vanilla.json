{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-03T16:48:42+00:00",
  "name": "Minecraft Vanilla",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Minecraft Vanilla using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/minecraft-vanilla:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 25565/tcp",
  "features": [
    "eula",
    "java_version"
  ],
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/minecraft-vanilla:latest"
  },
  "file_denylist": [],
  "startup": "/bin/sh -c 'rm -rf /data 2>/dev/null; ln -sfn /home/container /data; exec /entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \")! For help, type \"}",
    "logs": "{}",
    "stop": "stop"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
