{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-02T20:24:09+00:00",
  "name": "Garry's Mod",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Garry's Mod using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/gmod:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 27015/tcp, 27015/udp, 27005/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/gmod:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export GMOD_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Steam Username",
      "description": "Steam account for dedicated server installs. Use anonymous unless the game requires a login.",
      "env_variable": "STEAM_USERNAME",
      "default_value": "anonymous",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:64",
      "field_type": "text"
    },
    {
      "name": "Steam Password",
      "description": "Steam password when not using anonymous login.",
      "env_variable": "STEAM_PASSWORD",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string|max:64",
      "field_type": "text"
    },
    {
      "name": "Steam Guard Code",
      "description": "One-time Steam Guard code for SteamCMD login.",
      "env_variable": "STEAM_GUARD_CODE",
