  "exported_at": "2026-08-01T23:48:39+00:00",
  "name": "Sons Of The Forest",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Sons Of The Forest using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/sons-of-the-forest:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 8766/udp, 27016/udp, 9700/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/sons-of-the-forest:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export SOTF_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
