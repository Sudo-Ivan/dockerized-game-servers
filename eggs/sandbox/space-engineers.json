{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-03T16:48:42+00:00",
  "name": "Space Engineers",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Space Engineers using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/space-engineers:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 27016/udp, 8766/udp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/space-engineers:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export SE_ROOT=/home/container SE_DEDICATED_DIR=/home/container/dedicated SE_INSTANCES_DIR=/home/container/instances SE_PLUGINS_DIR=/home/container/plugins; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
