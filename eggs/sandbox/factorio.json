{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-04T01:53:12+00:00",
  "name": "Factorio",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Factorio using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/factorio:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 34197/udp, 27015/tcp",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/factorio:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export FACTORIO_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
