  "name": "Hytale",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Hytale using the dockerized-game-servers image. Docker image: deinfreu/hytale-server:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 5520/udp External image maintained outside this repository.",
  "features": null,
  "docker_images": {
    "Latest": "deinfreu/hytale-server:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'cd /home/container && exec /start.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
