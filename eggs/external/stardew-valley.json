{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-01T23:52:06+00:00",
  "name": "Stardew Valley",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Stardew Valley using the dockerized-game-servers image. Docker image: sdvd/server:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: -5800}:5800/tcp, -8080}:8080/tcp, -24642}:24642/udp, -27015}:27015/udp Requires a separate sdvd/steam-service container for Steam authentication. External image maintained outside this repository.",
  "features": null,
  "docker_images": {
    "Latest": "sdvd/server:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'mkdir -p /home/container/game /home/container/saves /home/container/settings /config/xdg/config/StardewValley; ln -sfn /home/container/saves /config/xdg/config/StardewValley; export SETTINGS_PATH=/home/container/settings/server-settings.json; exec /start.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
