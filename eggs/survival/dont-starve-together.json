{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-02T20:24:09+00:00",
  "name": "Don't Starve Together",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Don't Starve Together using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/dont-starve-together:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 10999/udp, 11000/udp, 27016/udp Set DST_CLUSTER_TOKEN from Klei accounts for public server listing.",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/dont-starve-together:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'export DST_DIR=/home/container; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Steam Username",
      "description": "Steam account for dedicated server installs. Use anonymous unless the game requires a login.",
