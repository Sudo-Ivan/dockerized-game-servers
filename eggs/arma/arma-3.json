{
  "_comment": "Pterodactyl egg for dockerized-game-servers",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-08-04T01:53:12+00:00",
  "name": "Arma 3",
  "author": "sudo-ivan@users.noreply.github.com",
  "description": "Arma 3 using the dockerized-game-servers image. Docker image: ghcr.io/sudo-ivan/dockerized-game-servers/arma-3:latest. Persistent data is stored under /home/container (mapped from the image data directory on startup). Default ports: 2302/udp, 2303/udp, 2304/udp, 2305/udp, 2306/udp Place modlist.html in server/modlist.html under the server data directory for workshop mod sync.",
  "features": null,
  "docker_images": {
    "Latest": "ghcr.io/sudo-ivan/dockerized-game-servers/arma-3:latest"
  },
  "file_denylist": [],
  "startup": "/bin/bash -c 'mkdir -p /home/arma3; for d in server configs profiles cache; do mkdir -p /home/container/$d; ln -sfn /home/container/$d /home/arma3/$d; done; export ARMA_DIR=/home/arma3/server; exec /docker-entrypoint.sh'",
  "config": {
    "files": "{}",
    "startup": "{\"done\": \"Starting\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Server files: /mnt/server\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\necho \"Install complete. Game files download on first container start.\"\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "name": "Steam Username",
      "description": "Steam account for dedicated server installs. Use anonymous unless the game requires a login.",
